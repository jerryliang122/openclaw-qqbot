{
  "name": "openclaw-qqbot",
  "version": "2.1.0",
  "description": "QQ Bot channel plugin for OpenClaw (forked version with enhanced features)",
  "private": true,
  "type": "module",
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "openclaw-qqbot": "./bin/qqbot-cli.js",
    "qqbot": "./bin/qqbot-cli.js"
  },
  "files": [
    "dist",
    "bin",
    "src",
    "skills",
    "scripts",
    "index.ts",
    "preload.cjs",
    "tsconfig.json",
    "tsup.config.ts",
    "openclaw.plugin.json"
  ],
  "openclaw": {
    "id": "openclaw-qqbot",
    "extensions": [
      "./preload.cjs"
    ],
    "channel": {
      "id": "qqbot",
      "label": "QQ Bot"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint:runtime": "npx tsx src/runtime-adapter/lint-runtime-access.ts"
  },
  "dependencies": {
    "@tencent-connect/qqbot-connector": "1.2.0",
    "@tencent-connect/qqbot-nodejs": "^1.0.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@tencent-connect/qqbot-connector": "1.2.0",
    "openclaw": "*"
  },
  "homepage": "https://github.com/jerryliang122/openclaw-qqbot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jerryliang122/openclaw-qqbot.git"
  }
}
